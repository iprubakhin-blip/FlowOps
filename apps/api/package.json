{
  "name": "@flowops/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "node -e \"process.env.NODE_ENV=process.env.NODE_ENV||'development'; require('child_process').spawnSync('npx', ['nest', 'start', '--watch'], {stdio:'inherit', env:process.env, shell:true})\"",
    "build": "nest build",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./dist/main.js')\"",
    "test": "tsx --import ./src/testing/ensure-test-env.ts --test src/domain/*.test.ts src/auth/*.test.ts src/http/*.test.ts src/database/migrate.checksum.test.ts",
    "test:integration": "tsx --import ./src/testing/ensure-test-env.ts --test src/*.integration.test.ts src/database/*.integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.12",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
