DATABASE_URL=postgresql://flowops:flowops_dev_password@localhost:5432/flowops
PORT=3000

# Required at process start: production, development, or test. Unset/unknown values refuse to boot.
# NODE_ENV=development

# Authentication (required to use /api/auth/*). Use a random string of at least 32 characters.
# Do not reuse the database password. Generate locally, never commit the real value.
JWT_SECRET=

# Cookie Secure flag. true/false. Defaults to true when NODE_ENV=production.
# Local HTTP must use false. Production refuses to start if this is false or invalid.
AUTH_COOKIE_SECURE=false

# Isolated non-production only. Production refuses to start if this is set.
# AUTH_ACCESS_TTL_SECONDS=8

# Comma-separated allowed browser Origins for cookie-authenticated auth requests.
AUTH_WEB_ORIGIN=http://127.0.0.1:4300

# Optional first ADMIN. Both must be set or both omitted. Used only when the users table is empty.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Required only when unowned legacy tasks exist and more than one ADMIN is present.
# Must match an existing ADMIN email. Never used to create or promote a user.
# TASK_LEGACY_OWNER_EMAIL=admin@example.com
